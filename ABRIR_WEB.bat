@echo off
cd /d "%~dp0"
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; $file=Join-Path (Get-Location) 'index.html'; $body=[IO.File]::ReadAllBytes($file); $server=[Net.Sockets.TcpListener]::new([Net.IPAddress]::Loopback,0); $server.Start(); $port=$server.LocalEndpoint.Port; Write-Host 'CarPark abierto. Deja esta ventana abierta mientras uses la web.'; Start-Process ('http://localhost:'+ $port +'/'); try { while($true){ $client=$server.AcceptTcpClient(); try { $client.ReceiveTimeout=3000; $stream=$client.GetStream(); $buffer=New-Object byte[] 8192; $read=$stream.Read($buffer,0,$buffer.Length); $request=[Text.Encoding]::ASCII.GetString($buffer,0,$read); if($request.StartsWith('GET / HTTP/') -or $request.StartsWith('GET /index.html HTTP/')){ $header='HTTP/1.1 200 OK'+[char]13+[char]10+'Content-Type: text/html; charset=utf-8'+[char]13+[char]10+'Content-Length: '+$body.Length+[char]13+[char]10+'Connection: close'+[char]13+[char]10+[char]13+[char]10; $bytes=[Text.Encoding]::ASCII.GetBytes($header); $stream.Write($bytes,0,$bytes.Length); $stream.Write($body,0,$body.Length) } else { $bytes=[Text.Encoding]::ASCII.GetBytes('HTTP/1.1 404 Not Found'+[char]13+[char]10+'Content-Length: 0'+[char]13+[char]10+'Connection: close'+[char]13+[char]10+[char]13+[char]10); $stream.Write($bytes,0,$bytes.Length) } } catch {} finally { $client.Close() } } } finally { $server.Stop() }"
pause
